# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; .env.example is committed as a template.
#
# In Vercel: add every one of these as an Environment Variable
# (Production + Preview + Development scopes) at
# Project Settings → Environment Variables.

# --- Supabase (public, safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# --- Supabase (server-only, never exposed to the browser) ---
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# --- Contact form ---
# Where lead-notification emails should go once the emailer is wired.
# Leave empty until then; submissions still land in the database.
CONTACT_TO_EMAIL=
